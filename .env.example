VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
VITE_ALCHEMY_API_KEY=your_alchemy_api_key

# Server-side only (Vercel env vars — do NOT prefix with VITE_, that would ship
# them to the browser).

# Password for the whole site. Also enforced on /api/wise-payouts.
SITE_PASSWORD=pick_something_long_and_random

# Wise API token, used by /api/wise-payouts for the Wise CSV check.
WISE_API_TOKEN=your_wise_api_token
# Optional: pin the profile instead of auto-picking the business one.
WISE_PROFILE_ID=
# Optional: https://api.sandbox.transferwise.tech to test against sandbox.
# Only that and https://api.transferwise.com are accepted; anything else falls
# back to production rather than being sent the token.
WISE_API_URL=
